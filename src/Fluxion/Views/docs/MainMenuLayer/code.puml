@startuml MainMenuView Workflow

!theme crt-amber

title MainMenuView - Code Flow and Actions

participant "Application" as app
participant "MainMenuView" as menu
participant "AppState" as state

== Initialization ==
app -> menu: AddView<MainMenuView>(app, render_priority)
menu -> menu: OnAdd()
menu --> app: View added

== Render Loop ==
app -> menu: OnIterate()
menu -> state: Get application state
state --> menu: State reference
menu --> app: Iteration done

app -> menu: OnRender()
menu -> menu: RenderMenu()
note right of menu
  Renders main menu bar
  File, Edit, View, etc.
end note
menu --> app: Menu rendered

== Cleanup ==
app -> menu: OnRemove()
menu --> app: Cleanup complete

@enduml
